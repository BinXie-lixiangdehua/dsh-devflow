{
  "name": "@xiaoxie-ide/dsh-devflow",
  "description": "DevFlow multi-agent workflow orchestration plugin for DeepSeek Harness",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_ZH.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BinXie-lixiangdehua/dsh-devflow.git"
  },
  "homepage": "https://github.com/BinXie-lixiangdehua/dsh-devflow#readme",
  "bugs": {
    "url": "https://github.com/BinXie-lixiangdehua/dsh-devflow/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "multi-agent",
    "orchestration",
    "workflow"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "vitest run tests",
    "prepublishOnly": "pnpm build && pnpm check"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-fs": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-user-questions": ">=0.1.5-rc.2 <0.2.0",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-util-values": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.5-rc.2 <0.2.0"
  },
